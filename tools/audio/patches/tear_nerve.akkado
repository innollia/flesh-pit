// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_nerve -- a taut cord tightening (thin whine), then a stringy crack and a twang that recoils.
pull_env = clamp(t / 0.14, 0, 1) * clamp((0.17 - t) / 0.03, 0, 1)
whine = saw(300 * PITCH + t * 900) * pull_env * 0.18 |> bp(@, 1300 * PITCH, 8.0)
crack = noise(0, 0, SEED) * (clamp((t - 0.16) / 0.002, 0, 1) * exp(neg(clamp(t - 0.16, 0, 100)) / 0.018)) * 0.9 |> hp(@, 1800)
twang_env = (clamp((t - 0.16) / 0.003, 0, 1) * exp(neg(clamp(t - 0.16, 0, 100)) / 0.2))
twang = saw(190 * PITCH * (1 - clamp(t - 0.16, 0, 1) * 0.6)) * twang_env * 0.6 |> bp(@, 850 * PITCH, 5.0)
wet = noise(0, 0, SEED2) * gt(noise(110, 0, SEED2), 0.5) * twang_env * 0.35 |> lp(@, 2000, 0.8)
out(whine + crack + twang + wet)
