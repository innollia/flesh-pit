// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_flesh -- a handful of raw muscle pulled until it gives. Stretch groan, then a wet rip that thins out.
stretch_env = clamp(t / 0.12, 0, 1) * clamp((0.22 - t) / 0.05, 0, 1)
stretch = saw(62 * PITCH + t * 40) * stretch_env * 0.30 |> lp(@, 380, 2.0)
rip_env = (clamp((t - 0.18) / 0.01, 0, 1) * exp(neg(clamp(t - 0.18, 0, 100)) / 0.16))
density = 0.2 + clamp(t - 0.18, 0, 1) * 1.6
crk = noise(0, 0, SEED) * gt(noise(150, 0, SEED2), density)
cf = (1500 - clamp((t - 0.18) * 2.5, 0, 1) * 1000) * PITCH
rip = crk * rip_env * 1.4 |> bp(@, cf, 1.6)
body = noise(0, 0, SEED2) * rip_env * 0.6 |> lp(@, 520, 0.9)
thump = sine(58 * PITCH) * (clamp((t - 0.18) / 0.004, 0, 1) * exp(neg(clamp(t - 0.18, 0, 100)) / 0.07)) * 0.7
out(stretch + rip + body + thump)
