// Breath through the nose. Turbulence through the nasal cavity's resonances,
// with narrow whistling peaks at chord pitches: a chord in the nostrils.
// A short double sniff cues each entry, the way a player breathes in.
fn exhale(f, g, v) -> {
  (noise(0, 0, 81) |> bp(@, f, 60)) * ar(g, 0.3, 4.6) ^ 2 * 7 * v
}
fn inhale(f, g, v) -> {
  (noise(0, 0, 82) |> bp(@, f * 2, 40)) * ar(g, 1.4, 0.05) ^ 2 * 3 * v
}
ch = n"<
  [d4,f4,a4] ~ [d4,f4,a4] ~ [d4,f4,a4] ~ [eb4,g4,bb4] ~
  [d4:0.6,f4:0.6,a4:0.6] ~ ~ ~ [d4:0.6,g4:0.6,bb4:0.6] ~ ~ ~
  [d4:0.75,f4:0.75,a4:0.75] ~ ~ ~ [d4:0.75,f4:0.75,a4:0.75] ~ ~ ~
  [f4:0.75,a4:0.75,c5:0.75] ~ ~ ~
  [d4,f4,bb4] ~ [eb4,g4,bb4] ~
  ~ ~ ~ ~
  [d4,f4,a4] ~ [eb4,g4,bb4] ~
  ~ ~ ~ ~
>"
inn = n"<
  ~ [~@3 [d4,f4,a4]@4] ~ [~@3 [d4,f4,a4]@4] ~ [~@3 [d4,f4,a4]@4] ~ [~@3 [eb4,g4,bb4]@4]
  ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
  ~ [~@3 [d4,f4,bb4]@4] ~ [~@3 [eb4,g4,bb4]@4]
  ~ ~ ~ ~
  ~ [~@3 [d4,f4,a4]@4] ~ [~@3 [eb4,g4,bb4]@4]
  ~ ~ ~ ~
>"
exq = n"<
  c4 ~ c4 ~ c4 ~ c4 ~
  c4:0.6 ~ ~ ~ c4:0.6 ~ ~ ~ c4:0.75 ~ ~ ~ c4:0.75 ~ ~ ~ c4:0.75 ~ ~ ~
  c4 ~ c4 ~ ~ ~ ~ ~ c4 ~ c4 ~ ~ ~ ~ ~
>" as xq
sn = n"<
  ~ ~ ~ ~ ~ ~ ~ [~@6 [c4@2 c4:1@3]]
  ~ ~ ~ ~ ~ ~ ~ [~@6 [c4@2 c4:1@3]]
  ~ ~ ~ ~ ~ ~ ~ [~@6 [c4@2 c4:1@3]]
  ~ ~ ~ [~@6 [c4@2 c4:1@3]]
  ~ ~ ~ [~@6 [c4@2 c4:1@3]]
  ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
>" as nq
nose = noise(0, 0, 83)
ee = ar(xq.trig, 0.3, 3.8) ^ 2 * xq.vel
base = ((nose |> bp(@, 980, 3)) + (nose |> bp(@, 2300, 3)) * 0.9 + (nose |> bp(@, 300, 1.6)) * 0.5) * ee * 0.42
se = ar(nq.gate, 0.07, 0.05)
air = ((noise(0, 0, 84) |> bp(@, 4000, 2.5)) + (noise(0, 0, 85) |> bp(@, 2300, 2.5)) * 0.8) * se * 1.4
dry = poly(ch, exhale, 12) + poly(inn, inhale, 12) + base + air
dry <>(1)
dry * 0.12 |> dattorro(@, 0.55, 5) |> hp(@, 200) <>(2)
