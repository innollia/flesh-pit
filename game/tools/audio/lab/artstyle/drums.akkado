hat = pan(tl |> lp(@, cut + 900, 0.7), -0.6) + pan(tr |> lp(@, cut + 900, 0.7), 0.6) + (tt |> lp(@, cut + 900, 0.7))
sna = snare |> lp(@, cut + 900, 0.7)
sends = sna * (0.3 + 0.6 * fg) + hat * 0.15 |> freeverb(@, 0.62, 0.45)
body * 0.5 + sna * 0.4 + hat * 0.32 + sends * 0.5 |> hp(@, 42) |> @ * 0.34 |> out(@)
