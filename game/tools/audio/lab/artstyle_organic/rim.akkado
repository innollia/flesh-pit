// generated by build.py; loop 368 steps + tail 64
sag = pow(2, slew(v"[0@110.5 -0.002@0.5 -0.01@0.5 -0.022@0.5 -0.038@0.5 -0.059@0.5 -0.084@0.5 -0.113@0.5 -0.146@0.5 -0.183@0.5 -0.222@0.5 -0.264@0.5 -0.309@0.5 -0.355@0.5 -0.402@0.5 -0.451@0.5 -0.5@0.5 -0.549@0.5 -0.598@0.5 -0.645@0.5 -0.691@0.5 -0.736@0.5 -0.778@0.5 -0.817@0.5 -0.854@0.5 -0.887@0.5 -0.916@0.5 -0.941@0.5 -0.962@0.5 -0.978@0.5 -0.99@0.5 -0.998@0.5 -1.0@232.5 -0.992@0.5 -0.97@0.5 -0.933@0.5 -0.883@0.5 -0.821@0.5 -0.75@0.5 -0.671@0.5 -0.587@0.5 -0.5@0.5 -0.413@0.5 -0.329@0.5 -0.25@0.5 -0.179@0.5 -0.117@0.5 -0.067@0.5 -0.03@0.5 -0.008@0.5 0.0@65]/108", 2.5) / 12)
fl = slew(v"[0@105 0.002@1 0.006@1 0.014@1 0.024@1 0.038@1 0.054@1 0.074@1 0.095@1 0.12@1 0.146@1 0.175@1 0.206@1 0.239@1 0.273@1 0.309@1 0.345@1 0.383@1 0.422@1 0.461@1 0.5@1 0.539@1 0.578@1 0.617@1 0.655@1 0.691@1 0.727@1 0.761@1 0.794@1 0.825@1 0.854@1 0.88@1 0.905@1 0.926@1 0.946@1 0.962@1 0.976@1 0.986@1 0.994@1 0.998@1 1.0@193 0.998@1 0.99@1 0.978@1 0.962@1 0.941@1 0.916@1 0.887@1 0.854@1 0.817@1 0.778@1 0.736@1 0.691@1 0.645@1 0.598@1 0.549@1 0.5@1 0.451@1 0.402@1 0.355@1 0.309@1 0.264@1 0.222@1 0.183@1 0.146@1 0.113@1 0.084@1 0.059@1 0.038@1 0.022@1 0.01@1 0.002@1 0.0@64]/108", 0.4)

n"[~@4.000 d4:0.500@28.000 ~@4.000 d4:0.450@26.000 ~@10.000 d4:0.500@52.000 ~@198.000 d4:0.400@40.000 ~@70.000]/108" as r
fn rimv(f, g, v) -> {
  e = adsr(g, 0.9, 0.1, 0.9, 1.2)
  sl = ar(g, 0.0002, 0.12)
  fr = f * (1 - 0.03 * sl * sl + 0.0028 * sine(4.3))
  tone = sine(fr) + 0.55 * sine(fr * 1.0034) + 0.15 * sine(fr * 2) + 0.05 * sine(fr * 3) + 0.03 * sine(fr * 2.76)
  rough = (noise(0, 0, 22) |> lp(@, 30)) * 3
  chat = 1 + rough * (0.08 + 0.5 * sl)
  fric = (noise(0, 0, 23) |> bp(@, 2500, 1.2)) * 0.05
  (tone * chat * e + fric * e) * v
}
dry = rimv(r.freq * sag, r.gate, r.vel) |> pan(@, 0.2)

tile = dry * 0.35 |> freeverb(@, 0.5, 0.15) |> hp(@, 300)
meat = dry * 0.5 |> freeverb(@, 0.82, 0.75) |> lp(@, 1600)
dry + tile * (1 - fl) * 0.9 + meat * fl |> hp(@, 120) |> @ * 0.14 |> out(@)
