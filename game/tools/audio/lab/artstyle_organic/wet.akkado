fn bub(lo, hi, th, seed) -> {
  p = noise(0, 0, seed) > th
  r = sah(noise(0, 0, seed + 1) * 0.5 + 0.5, p)
  fc = lo * (hi / lo) ^ r
  (p |> bp(@, fc, 13)) * 11
}
fn drip(f, g, v) -> sine(f * (1.6 - 0.9 * ar(g, 0.0003, 0.03)), 0, g) * ar(g, 0.0008, 0.06) ^ 2 * v
