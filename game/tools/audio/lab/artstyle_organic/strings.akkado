fn bowbody(x) -> bp(x, 380, 1.1) * 1.2 + bp(x, 1050, 1.4) * 0.7 + bp(x, 2700, 2.2) * 0.25 + x * 0.25
n"[d3:0.000@0.200 ~@63.634 d3:0.600@31.800 ~@0.412 c#3:0.600@15.800 ~@0.178 d3:0.600@7.800 ~@0.204 c#3:0.600@23.800 ~@0.210 a#2:0.600@15.400 ~@0.497 f3:0.600@15.400 ~@0.639 d#3:0.600@15.400 ~@0.690 d3:0.600@15.400 ~@0.579 a#2:0.600@15.400 ~@0.578 f3:0.600@15.400 ~@0.428 d#3:0.600@15.400 ~@0.805 d3:0.600@15.400 ~@0.663 a#2:0.600@15.400 ~@0.584 f3:0.600@15.400 ~@0.522 d#3:0.600@15.400 ~@16.421 a2:0.600@15.800 ~@0.450 d3:0.600@13.800 ~@66.106]/108" as cello

ntcello = slew(cello.note, 3)
vbcello = sine(5.55) * 0.1 * adsr(cello.gate, 0.7, 0.1, 1, 0.3)
sccello = (1 - adsr(cello.gate, 0.16, 0.01, 1, 0.2)) * 0.6
drcello = mono(noise(0, 0, 88) |> lp(@, 2.5)) * 2.5
frcello = mtof(ntcello + vbcello - sccello + drcello * 0.12) * sag
prcello = mono(noise(0, 0, 96) |> lp(@, 40)) * 4
gripcello = 1 + prcello * 0.18
hacello = sine(frcello) + sine(frcello * 2) * 0.5 + sine(frcello * 3) * 0.33 + sine(frcello * 4) * 0.22 + sine(frcello * 5) * 0.14 + sine(frcello * 6) * 0.08 + sine(frcello * 7) * 0.05
swcello = hacello * gripcello |> lp(@, frcello * 2.2 + 300)
haircello = (noise(0, 0, 70) |> bp(@, frcello * 2.5, 1.5)) * 0.22 * (0.6 + 0.4 * gripcello)
vcello = bowbody(swcello + haircello) * adsr(cello.gate, 0.22, 0.4, 0.85, 0.45) * cello.vel
