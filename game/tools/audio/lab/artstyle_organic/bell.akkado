fn bowl(f, g, v) -> {
  a = (sine(f) + 0.55 * sine(f * 1.0021)) * ar(g, 0.002, 2.6) ^ 2
  b = (0.3 * sine(f * 2.76) + 0.17 * sine(f * 2.771)) * ar(g, 0.0015, 1.2) ^ 2
  c = (0.12 * sine(f * 5.4) + 0.05 * sine(f * 8.93)) * ar(g, 0.001, 0.4) ^ 2
  mal = (noise(0, 0, 31) |> bp(@, 900, 0.7)) * ar(g, 0.001, 0.012) ^ 2 * 0.2
  (a + b + c + mal) * v
}
