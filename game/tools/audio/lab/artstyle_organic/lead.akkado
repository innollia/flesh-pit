fn bowbody(x) -> bp(x, 380, 1.1) * 1.2 + bp(x, 1050, 1.4) * 0.7 + bp(x, 2700, 2.2) * 0.25 + x * 0.25
n"[d4:0.000@0.200 ~@127.944 d4:0.833@11.850 a3:0.834@3.850 ~@0.254 e4:0.795@11.631 f4:0.753@3.850 ~@0.434 f4:0.836@7.758 e4:0.806@7.850 ~@0.268 d#4:0.818@7.850 ~@0.318 d4:0.792@7.835 d4:0.779@2.850 ~@0.145 a3:0.793@2.850 ~@0.117 e4:0.795@1.850 ~@0.021 f4:0.808@3.850 ~@0.377 e4:0.839@1.850 ~@0.193 c4:0.777@1.850 ~@0.162 d4:0.799@5.837 a3:0.757@1.850 ~@0.154 a#3:0.770@2.850 ~@0.414 a3:0.833@2.744 g3:0.797@1.850 ~@0.241 f3:0.796@2.630 a3:0.805@2.850 ~@0.412 c4:0.782@1.850 ~@0.149 e4:0.827@3.850 ~@0.086 d4:0.823@1.850 ~@0.584 a3:0.795@1.732 d#4:0.818@5.776 d4:0.814@1.850 ~@0.429 c#4:0.814@7.850 ~@0.144 d5:0.850@2.850 ~@0.153 a4:0.850@2.850 ~@0.313 e5:0.850@1.829 f5:0.850@3.850 ~@0.158 g5:0.850@1.850 ~@0.069 a5:0.850@1.850 ~@0.114 a#5:0.850@5.850 ~@0.263 a5:0.850@1.850 ~@0.140 g5:0.850@2.850 ~@0.058 f5:0.850@2.850 ~@0.198 e5:0.850@1.850 ~@0.215 f5:0.850@2.850 ~@0.159 e5:0.850@2.850 ~@0.068 d5:0.850@1.825 c5:0.850@3.850 ~@0.417 e5:0.850@1.850 ~@0.081 g5:0.850@1.850 ~@0.084 d#5:0.850@5.850 ~@0.201 d5:0.850@1.850 ~@0.072 c#5:0.850@3.850 ~@0.311 e5:0.850@1.850 ~@0.080 a5:0.850@1.850 ~@112.203]/108" as lead

ntlead = slew(lead.note, 9)
vblead = sine(5.42) * 0.16 * adsr(lead.gate, 0.7, 0.1, 1, 0.3)
sclead = (1 - adsr(lead.gate, 0.16, 0.01, 1, 0.2)) * 0.6
drlead = mono(noise(0, 0, 71) |> lp(@, 2.5)) * 2.5
frlead = mtof(ntlead + vblead - sclead + drlead * 0.12) * sag
prlead = mono(noise(0, 0, 77) |> lp(@, 40)) * 4
griplead = 1 + prlead * 0.18
halead = sine(frlead) + sine(frlead * 2) * 0.5 + sine(frlead * 3) * 0.33 + sine(frlead * 4) * 0.22 + sine(frlead * 5) * 0.14 + sine(frlead * 6) * 0.08 + sine(frlead * 7) * 0.05
swlead = halead * griplead |> lp(@, frlead * 3.2 + 300)
hairlead = (noise(0, 0, 57) |> bp(@, frlead * 2.5, 1.5)) * 0.22 * (0.6 + 0.4 * griplead)
vlead = bowbody(swlead + hairlead) * adsr(lead.gate, 0.22, 0.4, 0.85, 0.45) * lead.vel
n"[a#4:0.000@0.200 ~@255.833 a#4:0.550@2.850 ~@0.207 f4:0.550@2.850 ~@0.408 c#5:0.550@1.697 d5:0.550@3.850 ~@0.167 e5:0.550@1.850 ~@0.096 f5:0.550@1.850 ~@0.147 g5:0.550@5.850 ~@0.245 f5:0.550@1.850 ~@0.092 e5:0.550@2.850 ~@0.082 d5:0.550@2.850 ~@0.222 c#5:0.550@1.850 ~@0.135 d5:0.550@2.850 ~@0.160 c#5:0.550@2.850 ~@0.120 a#4:0.550@1.845 a4:0.550@3.850 ~@0.404 c#5:0.550@1.850 ~@0.070 e5:0.550@1.850 ~@0.089 c5:0.550@5.850 ~@0.219 a#4:0.550@1.850 ~@0.079 a#4:0.550@3.850 ~@0.293 c#5:0.550@1.850 ~@0.115 f5:0.550@1.850 ~@112.075]/108" as third

ntthird = slew(third.note, 9)
vbthird = sine(5.55) * 0.16 * adsr(third.gate, 0.7, 0.1, 1, 0.3)
scthird = (1 - adsr(third.gate, 0.16, 0.01, 1, 0.2)) * 0.6
drthird = mono(noise(0, 0, 88) |> lp(@, 2.5)) * 2.5
frthird = mtof(ntthird + vbthird - scthird + drthird * 0.12) * sag
prthird = mono(noise(0, 0, 96) |> lp(@, 40)) * 4
gripthird = 1 + prthird * 0.18
hathird = sine(frthird) + sine(frthird * 2) * 0.5 + sine(frthird * 3) * 0.33 + sine(frthird * 4) * 0.22 + sine(frthird * 5) * 0.14 + sine(frthird * 6) * 0.08 + sine(frthird * 7) * 0.05
swthird = hathird * gripthird |> lp(@, frthird * 3.2 + 300)
hairthird = (noise(0, 0, 70) |> bp(@, frthird * 2.5, 1.5)) * 0.22 * (0.6 + 0.4 * gripthird)
vthird = bowbody(swthird + hairthird) * adsr(third.gate, 0.22, 0.4, 0.85, 0.45) * third.vel

br = (noise(0, 0, 77) |> bp(@, mtof(ntlead) * sag * 3, 3)) * adsr(lead.gate, 0.3, 0.3, 0.6, 0.4) * lead.vel * 0.18
