// filters answer with a duplicated pair; stay mono until the very end
fn lpm(x, c, q) -> mono(lp(x, c, q))
fn bpn(x, c, q) -> mono(bp(x, c, q))
fn hpm(x, c) -> mono(hp(x, c))
amt = glide(heft, 0.03)

// tooth: a short FM bite, the ratio leaves 2 as the rounds get stranger
tooth_tr = gateup(tooth_p)
tooth_a = sah(tooth_p, tooth_tr)
rip_tr = gateup(rip_p)
rip_a = sah(rip_p, rip_tr)
tenv = ar(tooth_tr, 0.0004, 0.032)
tidx = ar(tooth_tr, 0.0004, 0.012)
tf = mtof(toothp)
tooth = sine(tf + sine(tf * toothr) * tf * 4 * tidx) * tenv * tooth_a
// rip: granular noise dragged upward over a resonant saw
renv = ar(rip_tr, 0.0005, 0.11)
rrise = 1 - renv
grain = gt(noise(230, 0, 51), 0)
ripn = bpn(noise(0, 0, 52), 1000 + 4200 * rrise, 1.6) * grain * renv * 1.6
ripb = lpm(saw(mtof(ripp + 12 * rrise)), 900 + 3600 * rrise, 2.5) * renv * 0.4
rip = (ripn + ripb) * rip_a
// riser: the pressure in the throat
rise = bpn(noise(0, 0, 61), glide(risef, 0.05), 3) * glide(riselvl, 0.05)
gl_ = (tooth * 0.4 + rip + rise * 0.8) * amt * 0.6
gr_ = (tooth * 0.9 + rip * 0.6 + rise * 0.6) * amt * 0.6
out(stereo(gl_, gr_))

