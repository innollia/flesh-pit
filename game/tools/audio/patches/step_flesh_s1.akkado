// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: step_flesh_s1 -- bare foot sinking into soft flesh. Stage 1 of mutation: W scales weight.
// 2026-11-08 (round7-sfx): no sine thud and no narrow band-pass, which rang at
// one pitch and read as a game blip once the quieter beds stopped covering it.
// The weight is low-passed noise, the squish a broad band, plus a few wet ticks.
// The room is the Room bus in the game (fp_audio_hookup), not baked in.
W = 1.0
hit = clamp(t / 0.004, 0, 1) * exp(neg(t) / (0.045 * W))
thump = noise(0, 0, SEED2 + 7) * hit * (0.9 * W) |> lp(@, (150 / W + 60) * PITCH, 0.7)
squish = noise(0, 0, SEED) * clamp((t - 0.01) / 0.025, 0, 1) * exp(neg(clamp(t - 0.01, 0, 100)) / (0.07 * W)) |> bp(@, (360 / W + 80) * PITCH, 2.2)
suck = noise(0, 0, SEED2) * gt(noise(60, 0, SEED2), 0.6) * exp(neg(t) / (0.1 * W)) * 0.3 |> lp(@, 700, 0.8)
wet = noise(0, 0, SEED + 3) * gt(noise(90, 0, SEED + 5), 0.82) * clamp((t - 0.03) / 0.02, 0, 1) * exp(neg(t) / (0.09 * W)) * 0.12 |> bp(@, 1700 * PITCH, 1.2)
out((squish * 0.45 + suck * 0.6 + thump * 1.8 + wet * 0.5) |> lp(@, 2400, 0.7))
