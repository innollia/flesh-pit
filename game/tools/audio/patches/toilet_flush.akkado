// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: toilet_flush -- lever clack, a rush of water that swirls down, then the cistern refilling.
clack = noise(0, 0, SEED) * (clamp((t - 0.0) / 0.001, 0, 1) * exp(neg(clamp(t - 0.0, 0, 100)) / 0.02)) * 0.8 |> bp(@, 2000, 2.0)
rush_env = clamp((t - 0.08) / 0.15, 0, 1) * clamp((2.3 - t) / 0.8, 0, 1)
rcf = (3000 - clamp(t / 2.2, 0, 1) * 2100) * PITCH
rush = noise(0, 0, SEED2) * rush_env * 0.9 |> lp(@, rcf, 0.9)
swirl = noise(0, 0, SEED) * rush_env * 0.5 |> bp(@, 600 + sine(3.5) * 250, 4.0)
refill_env = clamp((t - 1.8) / 0.4, 0, 1) * clamp((3.0 - t) / 0.3, 0, 1)
refill = noise(0, 0, SEED2) * refill_env * 0.18 |> hp(@, 2500)
out((clack + rush + swirl + refill) |> delay(@, 0.085, 0.3, 1.0, 0.3))
