// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: full_refuse -- the stomach is full and takes no more: pressure rises behind closed lips
// and is cut short, then a small dry burp. Nothing goes down and nothing comes up. Not gag_dry
// (two open retches: that one means "cannot vomit out here").
up = clamp((t - 0.03) / 0.07, 0, 1) * clamp((0.24 - t) / 0.035, 0, 1)
mm = noise(0, 0, SEED) * up * 1.6 |> bp(@, (240 + clamp(t / 0.2, 0, 1) * 120) * PITCH, 2.2)
cheek = noise(0, 0, SEED2) * up * 0.7 |> lp(@, 420 * PITCH, 0.7)
b = clamp((t - 0.33) / 0.03, 0, 1) * clamp((0.56 - t) / 0.12, 0, 1)
flut = gt(noise(34 * PITCH, 0, SEED + 4) + 0.2, 0) |> lp(@, 140, 0.7)
burp = noise(0, 0, SEED2 + 4) * b * flut * 1.2 |> bp(@, 330 * PITCH, 1.8)
nose = noise(0, 0, SEED + 9) * b * 0.2 |> bp(@, 1300, 1.2)
out((mm + cheek + burp + nose) * 0.5 |> lp(@, 2200, 0.7) |> hp(@, 150, 0.7))
