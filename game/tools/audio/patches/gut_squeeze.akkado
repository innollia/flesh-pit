// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: gut_squeeze -- a fold of bowel clamps shut nearby: a rising strain of pushed liquid that runs off along the tube.
env = clamp(t / 0.8, 0, 1) * clamp((2.6 - t) / 1.2, 0, 1)
tr = clamp((noise(14, 0, SEED) + 0.2) * 3, 0, 1) |> lp(@, 40, 0.7)
cf = (280 + 720 * clamp(t / 1.4, 0, 1) - 300 * clamp(t - 1.4, 0, 1)) * PITCH
g = noise(0, 0, SEED) * env * tr * 5 |> bp(@, cf, 11.0)
g2 = noise(0, 0, SEED2) * env * tr * 2.4 |> bp(@, cf * 1.8, 14.0)
push = noise(0, 0, SEED2) * env * 0.5 |> lp(@, 200, 1.0)
out(g + g2 + push |> freeverb(@, 0.3, 0.8, 0.28, 0.7, 0.9, 0.2) |> hp(@, 100))
