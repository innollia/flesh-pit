// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tank_lid -- heavy ceramic cistern lid lifted: grit scrape, then a dull clunk.
scrape_env = clamp(t / 0.05, 0, 1) * clamp((0.18 - t) / 0.05, 0, 1)
scrape = noise(0, 0, SEED) * scrape_env * 0.35 |> bp(@, 1500 * PITCH, 2.0)
clunk_env = (clamp((t - 0.17) / 0.002, 0, 1) * exp(neg(clamp(t - 0.17, 0, 100)) / 0.08))
clunk = (sine(420 * PITCH) + sine(1130 * PITCH) * 0.5) * clunk_env * 0.35 + sine(150 * PITCH) * clunk_env * 0.4
out((scrape + clunk) |> delay(@, 0.07, 0.3, 1.0, 0.3))
