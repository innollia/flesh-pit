// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_hair -- a matted clump of hair: dry strands drag tight, then come out roots and scalp
// together, many small plucks over a wet peel.
drag = clamp(t / 0.22, 0, 1) * clamp((0.34 - t) / 0.06, 0, 1)
gr = clamp((noise(210, 0, SEED) - 0.1) * 3, 0, 1)
hair = noise(0, 0, SEED) * drag * gr * 1.4 |> hp(@, (2400 + t * 2500) * PITCH, 0.8) |> lp(@, 8000, 0.7)
penv = clamp((t - 0.3) / 0.03, 0, 1) * exp(neg(clamp(t - 0.3, 0, 100)) / 0.16)
roots = noise(0, 0, SEED + 2) * gt(noise(300, 0, SEED + 3), 0.6) * penv * 1.3 |> bp(@, 2600 * PITCH, 1.0)
scalp = noise(0, 0, SEED2) * gt(noise(50, 0, SEED2 + 4), 0.2) * penv * 0.9 |> bp(@, 620 * PITCH, 1.3)
peel = noise(0, 0, SEED2 + 5) * penv * 0.5 |> bp(@, 380 * PITCH, 1.0)
out((hair + roots + scalp + peel) * 0.35 |> hp(@, 180, 0.7))
