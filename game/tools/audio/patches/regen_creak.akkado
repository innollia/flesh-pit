// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: regen_creak -- tissue regrowing in the dark: slow stick-slip creak, wet under-crackle. Never sharp.
env = clamp(t / 0.3, 0, 1) * clamp((1.1 - t) / 0.35, 0, 1)
rate = (48 + sine(1.3) * 18) * PITCH
creak = saw(rate) * env * 0.5 |> bp(@, 520 * PITCH, 5.0)
wet = noise(0, 0, SEED) * gt(noise(35, 0, SEED2), 0.6) * env * 0.35 |> lp(@, 1200, 0.8)
out(creak + wet)
