// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: nerve_twitch -- touching a nerve: the surrounding flesh clenches and
// quivers, wet fibres tightening.
// 2026-11-09 (round8-sfx): was a triangle squeak rising 600 -> 960 Hz and a
// 65 Hz sine (pitch clarity 0.69, CLAP "arcade" 0.99). Now the quiver is a
// broad band of noise fluttering at 17 Hz and the clench low-passed noise.
env = clamp((t - 0.01) / 0.04, 0, 1) * exp(neg(clamp(t - 0.01, 0, 100)) / 0.22)
trem = (sine(17 * PITCH) + 1) * 0.5
quiver = noise(0, 0, SEED) * env * trem * 0.9 |> bp(@, 1000 * PITCH, 1.4)
tight = noise(0, 0, SEED2 + 1) * gt(noise(320, 0, SEED2), 0.78) * env * trem * 0.5 |> bp(@, 1900 * PITCH, 1.0)
clench = noise(0, 0, SEED2 + 2) * env * 0.5 |> lp(@, 220 * PITCH, 0.7)
// A CC0 recording of wet mouth noises (sounds.json real_layer, a different
// stretch per variation) carries the wet; this gives the flutter.
out((quiver + tight + clench) * 0.5 |> hp(@, 55, 0.7))
