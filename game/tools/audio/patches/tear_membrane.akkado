// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_membrane -- rubbery sheet stretched: slow creaking ticks, then it splits with a hollow pop.
creak_env = clamp(t / 0.2, 0, 1) * clamp((0.38 - t) / 0.04, 0, 1)
ticks = gt(noise(38 * PITCH, 0, SEED), 0.3)
creak = noise(0, 0, SEED2) * ticks * creak_env * 0.8 |> bp(@, 720 * PITCH, 5.0)
pop_env = (clamp((t - 0.36) / 0.002, 0, 1) * exp(neg(clamp(t - 0.36, 0, 100)) / 0.06))
pop = sine(420 * PITCH * (1 - clamp((t - 0.36) * 8, 0, 0.8))) * pop_env * 0.7
flap = noise(0, 0, SEED) * (clamp((t - 0.37) / 0.01, 0, 1) * exp(neg(clamp(t - 0.37, 0, 100)) / 0.12)) * 0.6 |> bp(@, 1100, 1.2)
out(creak + pop + flap)
