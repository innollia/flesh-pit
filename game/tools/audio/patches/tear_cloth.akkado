// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_cloth -- soaked cloth buried in the flesh: threads give one after another, faster and
// faster, and the weave lets go. Wet (cloth_snag in the bed is the dry one).
env = clamp(t / 0.03, 0, 1) * clamp((0.7 - t) / 0.25, 0, 1)
runup = clamp(t / 0.45, 0, 1)
pops = clamp(noise(50 + runup * 170, 0, SEED) - 0.3, 0, 1) * 3
thread = noise(0, 0, SEED2) * env * pops * 1.6 |> bp(@, 1900 * PITCH, 1.1)
weave = noise(0, 0, SEED + 2) * env * runup * 0.6 |> bp(@, 1200 * PITCH, 0.8)
soak = noise(0, 0, SEED2 + 2) * gt(noise(40, 0, SEED2 + 4), 0.25) * env * 0.5 |> bp(@, 560 * PITCH, 1.4)
out((thread + weave + soak) * 0.35 |> lp(@, 4200, 0.7) |> hp(@, 250, 0.7))
