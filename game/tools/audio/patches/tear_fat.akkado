// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_fat -- greasy, soft, smearing. Less crackle than muscle, a slippery
// squelch that wobbles and sucks loose.
// 2026-11-09 (round8-sfx): was a 95 Hz sine sliding down and a Q 7 band that
// rang (pitch clarity 0.58, CLAP "arcade" 0.98). Now the slip is low-passed
// noise and the smear a broad band whose centre wanders.
env = clamp((t - 0.03) / 0.05, 0, 1) * exp(neg(clamp(t - 0.03, 0, 100)) / 0.24)
wob = noise(9, 0, SEED2 + 1) * 140
cf = (520 + wob - clamp(t, 0, 1) * 220) * PITCH
smear = noise(0, 0, SEED) * env * 0.6 |> bp(@, cf, 1.8)
suck = noise(0, 0, SEED2) * gt(noise(30, 0, SEED2 + 3), 0.35) * env * 0.35 |> bp(@, 300 * PITCH, 1.4)
crk = noise(0, 0, SEED2 + 2) * gt(noise(240, 0, SEED + 5), 0.8) * env * 0.25 |> bp(@, 1100 * PITCH, 0.9)
slip = noise(0, 0, SEED + 6) * env * 0.45 |> lp(@, 200 * PITCH, 0.7)
// Recordings carry it (sounds.json real_layer: the fat tear, which was mixed
// 40 dB under this patch before, and a low mud squelch, a different stretch
// per variation); this sits under them.
out((smear + suck + crk + slip) * 0.35 |> hp(@, 55, 0.7))
