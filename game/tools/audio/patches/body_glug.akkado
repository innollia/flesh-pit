// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: body_glug -- something swallows in the wall: two or three bubbles of liquid forced through a narrow place, pitch climbing.
env = clamp(t / 0.1, 0, 1) * clamp((1.5 - t) / 0.6, 0, 1)
open_ = clamp((noise(4.5, 0, SEED) + 0.3) * 3, 0, 1) |> lp(@, 28, 0.7)
cf = (260 + t * 240 + (noise(4.5, 0, SEED2) + 1) * 120) * PITCH |> lp(@, 14, 0.7)
g = noise(0, 0, SEED) * env * open_ * 5 |> bp(@, cf, 12.0)
g2 = noise(0, 0, SEED2) * env * open_ * 2 |> bp(@, cf * 2.1, 14.0)
out(g + g2 |> freeverb(@, 0.3, 0.8, 0.28, 0.7, 0.85, 0.25) |> hp(@, 120))
