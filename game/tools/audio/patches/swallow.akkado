// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: swallow -- a throat gulp: rising wet bandpass and a little slick crackle. No sine knock
// (round9-hand-tear: a 90 Hz larynx knock under the recording's chest thump read as a bang).
g = (clamp((t - 0.05) / 0.04, 0, 1) * exp(neg(clamp(t - 0.05, 0, 100)) / 0.18))
cf = (320 + clamp(t, 0, 0.4) * 900) * PITCH
gulp = noise(0, 0, SEED) * g * 1.6 |> bp(@, cf, 5.0)
wetc = noise(0, 0, SEED2) * gt(noise(50, 0, SEED2), 0.7) * g * 0.45 |> lp(@, 1800, 0.8)
out((gulp + wetc) * 0.4)
