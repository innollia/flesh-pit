// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: gut_trill -- gas runs through a loop of gut: a quick high trilling gurgle with a question-mark rise.
env = clamp(t / 0.08, 0, 1) * clamp((1.3 - t) / 0.5, 0, 1)
tr = clamp(sine(17 + t * 9) * 2 + noise(9, 0, SEED) * 0.6, 0, 1) |> lp(@, 60, 0.7)
cf = (540 + t * t * 380 + (noise(5, 0, SEED2) + 1) * 90) * PITCH |> lp(@, 18, 0.7)
out(noise(0, 0, SEED) * env * tr * 5 |> bp(@, cf, 15.0) |> hp(@, 200))
