// flesh-pit loop patch. bpm 60: trigger(n) fires n per second. Loop length is set in sounds.json; every rate here divides it.
// id: amb_body_b -- deeper shells: lower, denser, more pressure. Irregular wet gurgle bed, no steady engine-like drone.
swell = (sine(0.125) + 1) * 0.5
wob1 = (sine(0.033) + 1) * 0.5
wob2 = (sine(0.058) + 1) * 0.5
gurgle_l = noise(0, 0, 741) * gt(noise(2.4, 0, 743), 0.28 + wob1 * 0.18) * (0.32 + swell * 0.10) |> lp(@, 210 + wob1 * 45, 1.0) |> hp(@, 34)
gurgle_r = noise(0, 0, 747) * gt(noise(2.1, 0, 757), 0.28 + wob2 * 0.18) * (0.32 + swell * 0.10) |> lp(@, 210 + wob2 * 45, 1.0) |> hp(@, 34)
sub_l = sine(69.25) * 0.04
sub_r = sine(69.375) * 0.04
air_l = noise(0, 0, 711) * 0.28 |> lp(@, 440, 0.7) |> hp(@, 80)
air_r = noise(0, 0, 717) * 0.28 |> lp(@, 440, 0.7) |> hp(@, 80)
mid_l = noise(0, 0, 719) * (0.42 + swell * 0.12) |> bp(@, 360 + wob2 * 40, 2.2)
mid_r = noise(0, 0, 727) * (0.42 + swell * 0.12) |> bp(@, 360 + wob1 * 40, 2.2)
out(stereo(gurgle_l + sub_l + air_l + mid_l, gurgle_r + sub_r + air_r + mid_r))
