// flesh-pit loop patch. bpm 60. The fold in loopify hides the wrap, so no rate here has to divide the loop.
// id: amb_body_b -- plain flesh, deep: the weight of everything above. Long crushing strains (10-18 s apart) that make the whole
// body moan low, a wavering 55-75 Hz pulse heard through its harmonics at 170-520 Hz, and a tight wet crackle at the peak.
// Slower, heavier and more voiced than amb_body_a, never a steady drone: it lets go between strains.
load = (r, seed) -> {
    tb = phasor(r) / r
    clamp(tb / 6.0, 0, 1) * clamp((12.5 - tb) / 5.0, 0, 1) * gt(noise(r, 0, seed), neg(0.6))
}
l1 = 0.1 + load(0.071, 301) + load(0.053, 307) * 0.6
l2 = 0.1 + load(0.067, 311) + load(0.047, 313) * 0.6
wob_l = noise(1.7, 0, 317) |> lp(@, 1.2, 0.7)
wob_r = noise(1.4, 0, 331) |> lp(@, 1.1, 0.7)
moan_l = saw(mono(62 + l1 * 9 + wob_l * 5)) * l1 |> bp(@, 240, 2.4)
moan_r = saw(mono(66 + l2 * 8 + wob_r * 5)) * l2 |> bp(@, 215, 2.4)
form_l = saw(mono(62 + l1 * 9 + wob_l * 5)) * l1 * l1 |> bp(@, 470, 5.0)
form_r = saw(mono(66 + l2 * 8 + wob_r * 5)) * l2 * l2 |> bp(@, 430, 5.0)
crack_l = noise(0, 0, 337) * gt(noise(22, 0, 347), 0.6) * l1 * l1 |> bp(@, 900, 1.5)
crack_r = noise(0, 0, 349) * gt(noise(19, 0, 353), 0.6) * l2 * l2 |> bp(@, 820, 1.5)
under_l = noise(0, 0, 359) * (0.05 + l1 * 0.35) |> lp(@, 300, 0.8)
under_r = noise(0, 0, 367) * (0.05 + l2 * 0.35) |> lp(@, 300, 0.8)
l = moan_l * 1.6 + form_l * 1.2 + crack_l * 1.3 + under_l |> freeverb(@, 0.42, 0.8, 0.28, 0.7, 0.85, 0.28) |> hp(@, 70) |> lp(@, 1800)
r = moan_r * 1.6 + form_r * 1.2 + crack_r * 1.3 + under_r |> freeverb(@, 0.42, 0.8, 0.28, 0.7, 0.85, 0.28) |> hp(@, 70) |> lp(@, 1800)
out(stereo(l, r))
