// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: step_flesh_s3 -- bare foot sinking into soft flesh. Stage 3 of mutation: W scales weight.
W = 2.3
hit = clamp(t / 0.006, 0, 1) * exp(neg(t) / (0.05 * W))
squish = noise(0, 0, SEED) * clamp((t - 0.01) / 0.02, 0, 1) * exp(neg(clamp(t - 0.01, 0, 100)) / (0.08 * W)) |> bp(@, (700 / W) * PITCH, 2.5)
suck = noise(0, 0, SEED2) * gt(noise(80, 0, SEED2), 0.5) * exp(neg(t) / (0.12 * W)) * 0.4 |> lp(@, 1600, 0.8)
thud = sine((75 / W + 20) * PITCH) * hit * (0.3 * W)
out(squish * 0.9 + suck + thud)
