// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: tear_flesh -- a handful of raw muscle pulled until it gives: fibres creak
// under the pull, then pop apart in a wet run that thins out, a squelch under it.
// 2026-11-09 (round8-sfx): was a 62 Hz saw groan, a 58 Hz sine thump with a
// 4 ms attack and a band crackle that started in one hit; with the knife's
// scissors recording on top it read as a gunshot ("철컥 탕"). Now there is no
// oscillator: the weight is low-passed noise that swells over 25 ms, the rip is
// many small fibre pops that thicken and thin, the squelch a broad wet band.
pull = clamp(t / 0.16, 0, 1) * clamp((0.26 - t) / 0.06, 0, 1)
fib = noise(0, 0, SEED) * gt(noise(260, 0, SEED2), 0.82 - clamp(t / 0.2, 0, 1) * 0.12) * pull * 0.5 |> bp(@, 1500 * PITCH, 0.9)
strain = noise(0, 0, SEED2 + 1) * pull * 0.35 |> bp(@, 380 * PITCH, 1.3)
renv = clamp((t - 0.16) / 0.03, 0, 1) * exp(neg(clamp(t - 0.16, 0, 100)) / 0.17)
dens = 0.55 + clamp((t - 0.16) * 1.6, 0, 1) * 0.35
pops = noise(0, 0, SEED + 2) * gt(noise(700, 0, SEED + 3), dens) * renv
rip = (pops |> bp(@, (1100 - clamp((t - 0.16) * 2.0, 0, 1) * 500) * PITCH, 0.8)) * 1.3
wet = noise(0, 0, SEED2 + 2) * gt(noise(45, 0, SEED2 + 4), 0.2) * renv * 0.6 |> bp(@, 520 * PITCH, 1.6)
weight = noise(0, 0, SEED2 + 5) * clamp((t - 0.15) / 0.025, 0, 1) * exp(neg(clamp(t - 0.15, 0, 100)) / 0.09) * 0.5 |> lp(@, 240 * PITCH, 0.7)
// Recordings carry the tear (sounds.json real_layer: a tear, a second tear and a
// mud squelch, a different stretch of each per variation); this sits under them.
out((fib + strain + rip + wet + weight) * 0.35 |> lp(@, 5000, 0.7) |> hp(@, 60, 0.7))
