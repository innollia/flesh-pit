// flesh-pit sound patch. Render: bpm 60 so trigger(n) fires n times per second.
// t is seconds since the start of the render (phasor at 0.1 Hz, so valid < 10 s).
SEED = 101
SEED2 = 211
PITCH = 1.0
t = phasor(0.1) * 10
// id: grab_refuse -- bare fingers dig into tough rubbery muscle: a wet strain swelling as it
// stretches, then the grip slips off with a soft wet slide (the mud recording over it). Nothing
// splits. No sine thup and no ticking narrow creak (round9-hand-tear: a 130 Hz sine with a 4 ms
// attack and a Q 6 stick-slip ratchet read as a clack and a bang).
stretch_env = clamp(t / 0.12, 0, 1) * clamp((0.32 - t) / 0.06, 0, 1)
strain = noise(0, 0, SEED2) * stretch_env * 0.5 |> bp(@, (420 + clamp(t / 0.3, 0, 1) * 500) * PITCH, 1.4)
grit = noise(0, 0, SEED) * gt(noise(30 * PITCH, 0, SEED), 0.55) * stretch_env * 0.18 |> lp(@, 1400, 0.7)
slide = noise(0, 0, SEED) * (clamp((t - 0.27) / 0.03, 0, 1) * exp(neg(clamp(t - 0.27, 0, 100)) / 0.09)) * 0.35 |> bp(@, 650 * PITCH, 1.2)
out(strain + grit + slide)
