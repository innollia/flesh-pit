// flesh-pit loop patch. bpm 60: trigger(n) fires n per second. Loop length is set in sounds.json; every rate here divides it.
// id: chew_loop_b -- chewing after mutation: a bigger jaw, gristle crunch, slower-sounding and heavier. Same 0.4 s period.
trig = trigger(2.5)
bite = ar(trig, 0.008, 0.14)
squelch = noise(0, 0, 103) * bite * 0.6 |> bp(@, 550, 3.5)
crunch = noise(0, 0, 223) * gt(noise(200, 0, 311), 0.45) * ar(trig, 0.01, 0.12) * 0.32 |> hp(@, 1800)
wetc = noise(0, 0, 229) * gt(noise(90, 0, 331), 0.35) * ar(trig, 0.03, 0.26) * 0.6 |> lp(@, 1600, 0.8)
jaw = sine(58) * ar(trig, 0.004, 0.08) * 0.7
out((squelch + crunch + wetc + jaw) * 0.06)
