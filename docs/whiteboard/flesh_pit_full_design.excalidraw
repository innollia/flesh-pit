  {
   "id": "fi-sub",
   "type": "text",
   "x": 32,
   "y": 5306,
   "width": 768.0600000000001,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#6b625a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
