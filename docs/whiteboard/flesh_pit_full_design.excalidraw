   "seed": 1437018919,
   "version": 1,
   "versionNonce": 2001039320,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791800000000,
   "link": null,
   "locked": false,
   "text": "녹색 = 이번에 해결,  파랑 = 지금 상태 유지 승인,  회색 = 나중에 할 일.  사용자 코멘트는 원문 그대로",
   "originalText": "녹색 = 이번에 해결,  파랑 = 지금 상태 유지 승인,  회색 = 나중에 할 일.  사용자 코멘트는 원문 그대로",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
